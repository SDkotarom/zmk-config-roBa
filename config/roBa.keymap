#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        p {
            bindings = <&kp P>;
            key-positions = <8 9>;
        };

        lang_en {
            bindings = <&kp LANG2>;
            key-positions = <17 18>;
        };

        lang_jp {
            bindings = <&kp LANG1>;
            key-positions = <18 19>;
        };

        back_page {
            bindings = <&kp RG(LEFT_ARROW)>;
            key-positions = <29 30>;
        };

        forward_page {
            bindings = <&kp RG(RIGHT_ARROW)>;
            key-positions = <30 31>;
        };

        close {
            bindings = <&kp RG(W)>;
            key-positions = <19 18 20>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <12 13>;
        };

        all_select {
            bindings = <&kp LG(A)>;
            key-positions = <11 12>;
        };

        desktop {
            bindings = <&kp F11>;
            key-positions = <2 3 4>;
        };

        mission_control {
            bindings = <&kp F3>;
            key-positions = <1 2 3>;
        };

        user_switch {
            bindings = <&kp LG(LS(M))>;
            key-positions = <0 1>;
        };

        save {
            bindings = <&kp LG(S)>;
            key-positions = <14 13>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R   &kp T                                              &kp Y        &kp U  &kp I      &kp O    &kp BACKSPACE
&kp A             &kp S         &kp D         &kp F   &kp G      &kp LG(KP_NUMBER_0)      &tog 1         &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V   &kp B      &kp LG(Z)                &tog 2         &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &tog 5  &kp SPACE  &mt LEFT_SHIFT TAB       &kp BACKSPACE  &lt 1 ENTER                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_AC_ZOOM_IN C_AC_ZOOM_OUT>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp K_MUTE        &kp K_VOLUME_DOWN  &kp RS(C_VOLUME_UP)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp RS(NUMBER_4)  &kp RS(NUMBER_5)   &kp RS(NUMBER_6)     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp RS(NUMBER_1)  &kp RS(NUMBER_2)   &kp RS(NUMBER_3)     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                            &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp KP_EQUAL  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp PERIOD    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &kp KP_DIVIDE
            >;
        };

        ARROW {
            bindings = <
&kp LA(LC(LG(LEFT)))  &kp LC(LA(LG(RIGHT)))  &trans  &trans  &trans                        &trans  &trans              &kp RG(UP_ARROW)  &kp RG(DOWN_ARROW)  &trans
&trans                &trans                 &trans  &trans  &trans  &trans      &kp HOME  &trans  &kp RG(LEFT_ARROW)  &kp UP_ARROW      &kp RG(RIGHT)       &trans
&trans                &trans                 &trans  &trans  &trans  &trans      &kp END   &trans  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW     &trans
&trans                &trans                 &trans  &trans  &trans  &trans      &trans    &trans                                                            &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(LA(LG(RIGHT))) LC(LA(LG(LEFT)))>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
