#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <250>;
    tapping-term-ms = <200>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

&trackball_listener { input-processors = <&zip_xy_scaler 2 1>; };

/ {
    combos {
        compatible = "zmk,combos";

        p {
            bindings = <&kp P>;
            key-positions = <8 9>;
        };

        lang_en {
            bindings = <&kp LANG2>;
            key-positions = <17 18>;
        };

        lang_jp {
            bindings = <&kp LANG1>;
            key-positions = <18 19>;
        };

        back_page {
            bindings = <&kp RG(LEFT_ARROW)>;
            key-positions = <30 31 32>;
        };

        forward_page {
            bindings = <&kp RG(RIGHT_ARROW)>;
            key-positions = <31 32 33>;
        };

        close {
            bindings = <&kp RG(W)>;
            key-positions = <18 20 19>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <12 13>;
        };

        all_select {
            bindings = <&kp LG(A)>;
            key-positions = <11 12 10>;
        };

        desktop {
            bindings = <&kp F11>;
            key-positions = <2 3 4>;
        };

        mission_control {
            bindings = <&kp F3>;
            key-positions = <1 2 3>;
        };

        user_switch {
            bindings = <&kp LG(LS(M))>;
            key-positions = <0 1>;
        };

        save {
            bindings = <&kp LG(S)>;
            key-positions = <14 13 12>;
        };

        copy {
            bindings = <&kp RG(C)>;
            key-positions = <29 30>;
        };

        paste {
            bindings = <&kp RG(V)>;
            key-positions = <31 30>;
        };

        cut {
            bindings = <&kp RG(X)>;
            key-positions = <31 32>;
        };

        reload {
            bindings = <&kp LG(R)>;
            key-positions = <1 0 2>;
        };

        exclamation {
            bindings = <&kp LS(NUMBER_1)>;
            key-positions = <14 13>;
            slow-release;
            timeout-ms = <30>;
            require-prior-idle-ms = <200>;
        };

        question {
            bindings = <&kp LS(SLASH)>;
            key-positions = <26 25>;
        };

        colon {
            bindings = <&kp RS(SEMICOLON)>;
            key-positions = <20 21>;
        };

        equal {
            bindings = <&kp RS(EQUAL)>;
            key-positions = <33 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        pd_1: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp D &kp O &kp N &kp K &kp E &kp Y &kp K &kp O &kp N &kp G &kp N0 &kp N0>,
                <&macro_tap>;

            label = "NEW_MACRO";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        pd_2: pd_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(D) &kp R &kp A &kp S &kp T &kp I &kp C &kp UNDER &kp LS(M) &kp O &kp V &kp I &kp E &kp UNDER &kp N2 &kp N2 &kp N0 &kp N3>;
            label = "PD_2";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        pd_3: pd_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(D) &kp N0 &kp N &kp K &kp E &kp Y &kp UNDER &kp K &kp O &kp N &kp LS(G) &kp UNDER &kp N2 &kp N0 &kp N1 &kp N9>;
            label = "PD_3";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        blacket_and_left: blacket_set {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(NUMBER_9) &kp RS(NUMBER_0) &kp LEFT_ARROW>;
            label = "BLACKET_SET";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        slash: slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp SLASH>;
            label = "SLASH";
            wait-ms = <0>;
            tap-ms = <0>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R    &kp T                                                          &kp Y        &kp U  &kp I      &kp O    &kp BACKSPACE
&kp A      &kp S         &kp D         &lt 2 F  &lt 1 G             &kp LG(K_MUTE)          &blacket_and_left  &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&kp Z      &kp X         &kp C         &kp V    &kp B               &kp LG(Z)               &kp RIGHT_GUI      &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &mo 5    &mt LEFT_ALT SPACE  &mt LEFT_SHIFT TAB      &lt 1 AT           &lt 2 ENTER                             &mo 3
            >;

            sensor-bindings = <&inc_dec_kp LG(C_VOLUME_UP) LG(C_VOLUME_DOWN)>;
        };

        FUNC_ARROW {
            bindings = <
&kp LA(LG(LC(LEFT_ARROW)))  &kp LA(LC(LG(RIGHT)))  &none             &none             &kp LG(LS(NUMBER_4))                              &kp HOME  &kp END             &kp RG(UP_ARROW)  &kp RG(DOWN_ARROW)   &trans
&kp LS(NUMBER_6)            &kp LS(NUMBER_7)       &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)      &trans              &trans  &kp AT    &kp LG(LEFT_ARROW)  &kp UP_ARROW      &kp RG(RIGHT_ARROW)  &trans
&kp LS(NUMBER_1)            &kp LS(NUMBER_2)       &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)      &trans              &trans  &trans    &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &trans
&trans                      &trans                 &trans            &trans            &trans                &kp LEFT_SHIFT      &trans  &trans                                                               &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(LA(RIGHT)) LG(LA(LEFT_ARROW))>;
        };

        NUM {
            bindings = <
&kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS      &kp KP_PLUS                            &kp PERIOD    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans
&trans        &trans         &trans           &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans      &trans  &kp COMMA     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans
&trans        &trans         &trans           &kp LS(NUMBER_9)  &kp LS(NUMBER_0)   &trans      &trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &slash
&trans        &trans         &trans           &trans            &trans             &trans      &trans  &trans                                                  &trans
            >;
        };

        PD_BTSET {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans  &trans  &trans
&trans  &trans  &trans  &pd_1   &pd_2   &pd_3       &trans  &trans                                      &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp LEFT_SHIFT      &trans  &trans                          &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
